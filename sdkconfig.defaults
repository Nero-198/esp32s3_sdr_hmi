CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# ESP32-S3-WROOM-1 N16R8: octal PSRAM holds the RGB frame buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Lets the RGB DMA keep fetching from PSRAM while flash is busy.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Console on UART0 (CH340 bridge); native USB pins carry GT911 I2C.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ESP-SDR receiver (upstream sdkconfig.defaults*, minus its single-core ring setup).
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# CONFIG_PM_ENABLE is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4

# LVGL 9 (managed component)
CONFIG_LV_COLOR_DEPTH_16=y
# main/lv_mem_psram.c puts all LVGL allocations in PSRAM.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# 16 MB flash: one 4 MB app partition (LVGL + Wi-Fi/PHY libs exceed 1 MB).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL task stack lives in PSRAM (xTaskCreatePinnedToCoreWithCaps).
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Larger D-cache with 64-byte lines speeds up PSRAM-heavy drawing (canvases,
# LVGL blits, double-buffer sync). Costs 32 KiB of internal SRAM.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
